#
# the kernel6.18.y config for bdkj-one
#-------------------------------------
#
# Core essential
#
CONFIG_EXPERT=y
CONFIG_EMBEDDED=y
CONFIG_PRINTK=y
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

#
# FAN53555 I2C可编程DC‑DC电源【本次新增】
#
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FAN53555=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

#
# Docker / Namespace / Cgroup 必备
#
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_OVERLAY_FS=y

#
# WireGuard / PPPoE
#
CONFIG_WIREGUARD=y
CONFIG_PPP=y
CONFIG_PPPOE=y
CONFIG_PPP_BSDCOMP=m
CONFIG_PPP_DEFLATE=m
CONFIG_PPP_MPPE=m

#
# firewall4 nftables，关闭旧xtables iptables
#
CONFIG_NF_TABLES=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_CT=m
CONFIG_NFT_FLOW_OFFLOAD=m
CONFIG_NFT_FIB_INET=m
# CONFIG_NETFILTER_XTABLES is not set
# CONFIG_IP_NF_IPTABLES is not set
# CONFIG_IP6_NF_IPTABLES is not set

#
# WAN口 RTL8211F PHY + RK GMAC MAC控制器
#
CONFIG_REALTEK_PHY=y
CONFIG_STMMAC_ETH=y
CONFIG_DWMAC_ROCKCHIP=y

#
# DRM / HDMI Display (Rockchip DW‑HDMI RK3568)
#
CONFIG_DMA_CMA=y
CONFIG_CMA=y
CONFIG_CMA_SIZE_MBYTES=64
CONFIG_FB=y
CONFIG_FB_SYS_FILLRECT=y
CONFIG_FB_SYS_COPYAREA=y
CONFIG_FB_SYS_IMAGEBLIT=y
CONFIG_FB_SYS_FOPS=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VIDEOMODE_HELPERS=y

CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_PANEL_SIMPLE=y

CONFIG_DRM_DW_HDMI=y
CONFIG_DRM_DW_HDMI_I2S_AUDIO=y
# CONFIG_DRM_DW_HDMI_CEC=n

CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP2=y
CONFIG_ROCKCHIP_DW_HDMI=y

#
# Hardware Monitoring / GPIO Bitbang 机箱风扇
#
CONFIG_HWMON=y
CONFIG_SENSORS=y
CONFIG_SENSORS_GPIO_FAN=y
CONFIG_PWM=y
CONFIG_GPIO_SYSFS=y

#
# USB DWC3 Host (USB <-> SATA0 mux channel, DWC3 of_simple binding)
#
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_HOST=y
CONFIG_USB_DWC3_OF_SIMPLE=y
CONFIG_USB_STORAGE=y
CONFIG_USB_COMMON=y

#
# SATA AHCI控制器（2个SATA口，SATA0与DWC3通道复用）
#
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SATA_AHCI_PLATFORM=y

#
# RK3568 PCIe RC + NVMe M.2固态硬盘
#
CONFIG_PCI=y
CONFIG_PCI_DOMAINS=y
CONFIG_PCI_HOST_COMMON=y
CONFIG_PCIE_DW=y
CONFIG_PCIE_DW_HOST=y
CONFIG_PCIE_ROCKCHIP=y
CONFIG_PCIE_ROCKCHIP_DW_HOST=y

CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_HWMON=y

#
# eMMC HS200 (DWCMSHC‑SDHCI控制器)
#
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y
CONFIG_MMC_CQ_HCI=y

#
# Network DSA Switch for RTL8367S (复用RTL8365MB驱动)
#
CONFIG_NET=y
CONFIG_NET_DEVICES=y
CONFIG_NET_SWITCHDEV=y
CONFIG_NET_DSA=y
CONFIG_NET_DSA_TAG_RTL8_4=y
CONFIG_NET_DSA_REALTEK=y
CONFIG_NET_DSA_REALTEK_MDIO=y
CONFIG_NET_DSA_REALTEK_SMI=y
CONFIG_NET_DSA_REALTEK_RTL8365MB=y
CONFIG_VLAN_8021Q=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_BRIDGE_NETFILTER=n

#
# Network basic
#
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NET_IPGRE_DEMUX=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NET_KEY=y
CONFIG_XFRM=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_NF_CONNTRACK=y

#
# MDIO bus subsystem (DSA/SMI/PHY 必需)
#
CONFIG_MDIO=y
CONFIG_MDIO_DEVICE=y

#
# 文件系统 ImmortalWrt必需
#
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
#
# 关闭调试，减小内核体积
#
CONFIG_DEBUG_FS=y
CONFIG_KGDB=n
CONFIG_GDB_SCRIPTS=n
CONFIG_KALLSYMS=n
CONFIG_KALLSYMS_ALL=n
CONFIG_DYNAMIC_DEBUG=n
CONFIG_FTRACE=n
CONFIG_KASAN=n
CONFIG_UBSAN=n
